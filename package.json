{
  "name": "roomboy",
  "version": "1.0.0",
  "description": "Haru room game — TypeScript and replaceable procedural assets",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "assets:convert": "node --import tsx tools/glb-to-vertices.ts",
    "assets:parts": "node scripts/bake-head-regions.mjs && node scripts/bake-head-regions.mjs public/heads/grey-head-lod1-10000.glb public/heads/grey-head-lod1-10000",
    "pretest": "npm run assets:parts",
    "prebuild": "npm run assets:parts",
    "assets:lod1": "python scripts/build-head-lod1.py"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "three": "^0.160.0",
    "three-csg-ts": "3.2.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "private": true
}
